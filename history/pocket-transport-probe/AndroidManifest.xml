<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.cv10.monado.pocket_transport_probe">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="31" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <queries><package android:name="com.hayeco.flipspaces" /><package android:name="moe.shizuku.privileged.api" /></queries>
    <application android:label="CV10 Display Transport Test" android:debuggable="true">
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <provider android:name="rikka.shizuku.ShizukuProvider"
                  android:authorities="org.cv10.monado.pocket_transport_probe.shizuku"
                  android:exported="true" android:multiprocess="false"
                  android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name="org.freedesktop.monado.openxr_runtime.TransportProbeActivity" android:exported="true" />
    </application>
</manifest>
