+    private fun startOpticalDiagnostic() {
+        if (renderer != null || stopping) return
+        lateinit var diagnostic: Cv10PocketXrRenderer
+        diagnostic = Cv10PocketXrRenderer(
+            activity = this,
+            captureWidth = 1920,
+            onSurface = { surface ->
+                if (renderer === diagnostic) {
+                    try {
+                        val manager = getSystemService(DisplayManager::class.java)
+                        val display = checkNotNull(manager.createVirtualDisplay(
+                            "CV10 Pocket XR Optical Diagnostic", 1920, 1080, 240, surface,
+                            DisplayManager.VIRTUAL_DISPLAY_FLAG_PUBLIC or DisplayManager.VIRTUAL_DISPLAY_FLAG_OWN_CONTENT_ONLY,
+                        ))
+                        opticalDiagnostic = display
+                        Log.i(TAG, "Public diagnostic display id=${display.display.displayId}")
+                    } catch (error: RuntimeException) {
+                        showError(error)
+                    }
+                }
+            },
+            onFirstFrame = {
+                if (renderer === diagnostic) {
+                    controlsAvailable = true
+                    updateButtons()
+                    Log.i(TAG, "First public diagnostic display frame")
+                }
+            },
+            onFinished = { failure ->
+                if (renderer === diagnostic) {
+                    if (failure == null) stopPreview(getString(R.string.cv10_pocket_preview_session_ended))
+                    else showError(IllegalStateException(failure))
+                }
+            },
+        )
+        renderer = diagnostic
+        status.postDelayed({
+            if (renderer === diagnostic) stopPreview(getString(R.string.cv10_pocket_preview_intro))
+        }, 90_000)
+        updateButtons()
+        diagnostic.start()
+    }
