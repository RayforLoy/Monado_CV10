new file mode 100644
index 0000000..fca5533
--- /dev/null
+++ b/services/surfaceflinger/Scheduler/include/scheduler/FollowerSlot.h
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+
+namespace android::scheduler {
+
+// Initial budgets for a complete phone-only composition on the Fold7 main thread.
+// They are sampled from the stock phone-led control and need validation on a system build.
+constexpr int64_t kFollowerRetireGuardNs = 500'000;
+constexpr int64_t kFollowerRetirePredictionSlackNs = 500'000;
+constexpr int64_t kFollowerWorkNs = 2'750'000;
+constexpr int64_t kPacesetterWakeGuardNs = 500'000;
+constexpr int64_t kFollowerStartLeadNs = 7'800'000;
+constexpr int64_t kFollowerDeadlinePredictionSlackNs = 250'000;
+constexpr int64_t kFollowerPlanningLeadNs = kFollowerStartLeadNs + kFollowerDeadlinePredictionSlackNs;
+constexpr int64_t kFollowerMaxPhaseChangeNs = 1'000'000;
+
+struct FollowerSlot {
+    int64_t targetPresentNs;
+    int64_t wakeNs;
+    int64_t latestStartNs;
+};
+
+constexpr std::optional<FollowerSlot> planFollowerSlot(int64_t nowNs, int64_t targetPresentNs,
+                                                       int64_t phonePeriodNs,
+                                                       std::optional<int64_t> nextCv10WakeNs) {
+    if (!nextCv10WakeNs || phonePeriodNs <= 0) return std::nullopt;
+    const int64_t estimatedReady = targetPresentNs - phonePeriodNs + kFollowerRetireGuardNs +
+            kFollowerRetirePredictionSlackNs;
+    const int64_t earliest = std::max(nowNs, estimatedReady);
+    const int64_t latest = std::min(targetPresentNs - kFollowerPlanningLeadNs,
+                                    *nextCv10WakeNs - kPacesetterWakeGuardNs - kFollowerWorkNs);
+    if (earliest > latest) return std::nullopt;
+    return FollowerSlot{targetPresentNs, earliest, latest};
+}
+
+enum class FollowerSlotResult {
+    kReady,
+    kOutsideReservation,
+    kFenceUnavailable,
+    kRetireSettling,
+    kPacesetterWakeUnavailable,
+    kPacesetterWakeTooClose,
+    kFollowerVsyncMoved,
+};
+
+constexpr FollowerSlotResult recheckFollowerSlot(const FollowerSlot& slot, int64_t nowNs,
+                                                 bool fencePending, std::optional<int64_t> retireNs,
+                                                 std::optional<int64_t> nextCv10WakeNs,
+                                                 int64_t updatedTargetPresentNs) {
+    if (nowNs < slot.wakeNs || nowNs > slot.latestStartNs) {
+        return FollowerSlotResult::kOutsideReservation;
+    }
+    if (fencePending || !retireNs) return FollowerSlotResult::kFenceUnavailable;
+    if (nowNs - *retireNs < kFollowerRetireGuardNs) return FollowerSlotResult::kRetireSettling;
+    if (!nextCv10WakeNs) return FollowerSlotResult::kPacesetterWakeUnavailable;
+    if (*nextCv10WakeNs - nowNs < kPacesetterWakeGuardNs + kFollowerWorkNs) {
+        return FollowerSlotResult::kPacesetterWakeTooClose;
+    }
+    const int64_t phaseChange = updatedTargetPresentNs - slot.targetPresentNs;
+    if (phaseChange < -kFollowerMaxPhaseChangeNs || phaseChange > kFollowerMaxPhaseChangeNs ||
+        updatedTargetPresentNs - nowNs < kFollowerStartLeadNs) {
+        return FollowerSlotResult::kFollowerVsyncMoved;
+    }
+    return FollowerSlotResult::kReady;
+}
+
+} // namespace android::scheduler
