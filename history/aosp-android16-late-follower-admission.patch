diff --git a/services/surfaceflinger/Scheduler/include/scheduler/FollowerFenceAdmission.h b/services/surfaceflinger/Scheduler/include/scheduler/FollowerFenceAdmission.h
new file mode 100644
index 0000000..1f35537
--- /dev/null
+++ b/services/surfaceflinger/Scheduler/include/scheduler/FollowerFenceAdmission.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+namespace android::scheduler {
+
+enum class FollowerFenceAdmission { kReady, kWaitingForFence, kRetireSettling };
+
+constexpr FollowerFenceAdmission followerFenceAdmission(int64_t nowNs, bool pending,
+                                                         std::optional<int64_t> signalNs) {
+    if (pending) return FollowerFenceAdmission::kWaitingForFence;
+    // SM-F9660 research captures showed that the CRTC worker can remain busy for
+    // 0.448 ms after it signals the previous retire fence.
+    constexpr int64_t kRetireGuardNs = 500'000;
+    if (signalNs && (nowNs < *signalNs || nowNs - *signalNs < kRetireGuardNs)) {
+        return FollowerFenceAdmission::kRetireSettling;
+    }
+    return FollowerFenceAdmission::kReady;
+}
+
+} // namespace android::scheduler
