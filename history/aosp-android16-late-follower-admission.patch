+bool SurfaceFlinger::deferFollowerBeforeComposition(PhysicalDisplayId pacesetterId,
+                                                    PhysicalDisplayId followerId,
+                                                    const scheduler::FrameTargeter& targeter) {
+    static const uint64_t cv10Id =
+            base::GetUintProperty<uint64_t>("debug.sf.cv10_gate_pacesetter_display", 0);
+    static const uint64_t phoneId =
+            base::GetUintProperty<uint64_t>("debug.sf.cv10_gate_follower_display", 0);
+    if (cv10Id == 0 || phoneId == 0 || pacesetterId.value != cv10Id || followerId.value != phoneId) {
+        return false;
+    }
+
+    // A deferred output must not consume global geometry, color or buffer cleanup work.
+    // The upstream forced-client path retains the previous GPU read fence when it skips
+    // a slower follower. Keep ordinary composition if that path is unavailable.
+    if (!FlagManager::getInstance().force_slower_follower_gpu_composition() ||
+        mGeometryDirty.load() || mVisibleRegionsDirty || mFrontEndDisplayInfosChanged ||
+        mDrawingState.colorMatrixChanged || !mBufferIdsToUncache.empty() ||
+        !mLayersWithBuffersRemoved.empty() || mNumTrustedPresentationListeners > 0) {
+        return false;
+    }
+
+    {
+        Mutex::Autolock lock(mStateLock);
+        const auto cv10 = getDisplayDeviceLocked(pacesetterId);
+        const auto phone = getDisplayDeviceLocked(followerId);
+        if (!cv10 || !phone || phone->getPowerMode() != hal::PowerMode::ON) return false;
+        const auto& cv10Selector = cv10->refreshRateSelector();
+        const auto& phoneSelector = phone->refreshRateSelector();
+        if (!cv10Selector.hasActiveMode() || !phoneSelector.hasActiveMode()) return false;
+        const Fps cv10Rate = cv10Selector.getActiveMode().modePtr->getVsyncRate();
+        const Fps phoneRate = phoneSelector.getActiveMode().modePtr->getVsyncRate();
+        if (!cv10Rate.isValid() || !phoneRate.isValid() ||
+            phoneRate.getPeriod() <= cv10Rate.getPeriod()) {
+            return false;
+        }
+
+        const auto& phoneState = phone->getCompositionDisplay()->getState();
+        if (!phoneState.isEnabled || !phoneState.usesClientComposition ||
+            phoneState.usesDeviceComposition) {
+            return false;
+        }
+        for (const auto& [_, display] : mDisplays) {
+            if (display->getId() != phone->getId() &&
+                display->getLayerStack() == phone->getLayerStack()) {
+                return false;
+            }
+        }
+    }
+
+    const nsecs_t now = systemTime();
+    const nsecs_t signal = targeter.target().presentFenceForPreviousFrame()->getSignalTime();
+    const size_t pending = targeter.countPresentFencesPendingAt(TimePoint::fromNs(now));
+    const auto retire = Fence::isValidTimestamp(signal) ? std::optional<int64_t>{signal}
+                                                        : std::nullopt;
+    const auto decision = scheduler::followerFenceAdmission(now, pending != 0, retire);
+    SFTRACE_FORMAT_INSTANT("CV10 late gate display=%" PRIu64 " decision=%d pending=%zu "
+                           "now=%" PRId64 " fence=%" PRId64,
+                           followerId.value, static_cast<int>(decision), pending, now, signal);
+    if (decision == scheduler::FollowerFenceAdmission::kReady) return false;
+
+    // Retain the follower's last actual presentation and reconsider it on the next tick.
+    scheduleComposite(FrameHint::kNone);
+    return true;
+}
