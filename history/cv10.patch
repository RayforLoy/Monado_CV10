@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.freedesktop.monado.openxr_runtime;
+
+import android.hardware.usb.UsbConstants;
+import android.hardware.usb.UsbDevice;
+import android.hardware.usb.UsbDeviceConnection;
+import android.hardware.usb.UsbEndpoint;
+import android.hardware.usb.UsbInterface;
+import android.hardware.usb.UsbManager;
+import android.os.SystemClock;
+import android.util.Log;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+
+/** Wakes the headset panels through their runtime PCUI port without blocking IMU acquisition. */
+final class Cv10PanelWake {
+    private static final String TAG = "MonadoCV10";
+    private int requestedId = -1;
+
+    synchronized void request(UsbManager usb, UsbDevice glass) {
+        if (glass.getVendorId() != 0x12d1 || glass.getProductId() != 0x107e
+                || requestedId == glass.getDeviceId() || !usb.hasPermission(glass)) return;
+        requestedId = glass.getDeviceId();
+        new Thread(() -> {
+            for (int attempt = 0; attempt < 2; attempt++) {
+                try {
+                    UsbDevice attached = usb.getDeviceList().get(glass.getDeviceName());
+                    if (attached == null || attached.getDeviceId() != glass.getDeviceId()
+                            || !usb.hasPermission(attached)) return;
+                    wake(usb, attached);
+                    return;
+                } catch (IOException error) {
+                    Log.w(TAG, "CV10 PCUI attempt " + (attempt + 1) + ": " + error.getMessage());
+                    if (attempt == 0) SystemClock.sleep(600);
+                } catch (RuntimeException error) {
+                    Log.w(TAG, "CV10 PCUI unavailable", error);
+                    return;
+                }
+            }
+        }, "CV10-PCUI").start();
+    }
+
+    private static void wake(UsbManager usb, UsbDevice glass) throws IOException {
+        for (int i = 0; i < glass.getInterfaceCount(); i++) {
+            UsbInterface iface = glass.getInterface(i);
+            if (iface.getId() != 0 || iface.getAlternateSetting() != 0 || iface.getInterfaceClass() != 0xff
+                    || iface.getInterfaceSubclass() != 0x13 || iface.getInterfaceProtocol() != 0x12) continue;
+            UsbEndpoint in = null, out = null;
+            for (int j = 0; j < iface.getEndpointCount(); j++) {
+                UsbEndpoint ep = iface.getEndpoint(j);
+                if (ep.getType() != UsbConstants.USB_ENDPOINT_XFER_BULK) continue;
+                if (ep.getAddress() == 0x81) in = ep;
+                if (ep.getAddress() == 0x01) out = ep;
+            }
+            if (in == null || out == null) break;
+            UsbDeviceConnection port = usb.openDevice(glass);
+            if (port == null) throw new IOException("open failed");
+            try {
+                if (!port.claimInterface(iface, false)) throw new IOException("interface busy");
+                try {
+                    String model = query(port, in, out, "AT^DEVMODEL?");
+                    boolean cv10 = hasLine(model, "^DEVMODEL:CV10");
+                    if (!cv10) {
+                        String version = query(port, in, out, "AT^SWVER");
+                        for (String line : version.split("[\r\n]+")) {
+                            if (line.trim().matches("MAINVER:CV10AC[0-9.]+")) cv10 = true;
+                        }
+                    }
+                    if (!cv10) {
+                        Log.w(TAG, "PCUI identity did not confirm CV10");
+                        return;
+                    }
+                    String reply = query(port, in, out, "AT^SWITCHSCREEN=1");
+                    if (!hasLine(reply, "OK")) throw new IOException("panel command rejected");
+                    Log.i(TAG, "CV10 PCUI AT^SWITCHSCREEN=1 OK");
+                    return;
+                } finally {
+                    port.releaseInterface(iface);
+                }
+            } finally {
+                port.close();
+            }
+        }
+        Log.w(TAG, "CV10 PCUI runtime interface or endpoints missing");
+    }
+
+    private static boolean hasLine(String reply, String expected) {
+        for (String line : reply.split("[\r\n]+")) {
+            if (expected.equals(line.trim())) return true;
+        }
+        return false;
+    }
+
+    private static String query(UsbDeviceConnection port, UsbEndpoint in, UsbEndpoint out, String command)
+            throws IOException {
+        byte[] request = (command + "\r\n").getBytes(StandardCharsets.US_ASCII);
+        if (port.bulkTransfer(out, request, request.length, 1000) != request.length) {
+            throw new IOException(command + " send incomplete");
+        }
+        long end = SystemClock.elapsedRealtime() + 2000;
+        ByteArrayOutputStream collected = new ByteArrayOutputStream();
+        byte[] packet = new byte[in.getMaxPacketSize()];
+        while (SystemClock.elapsedRealtime() < end && collected.size() < 4096) {
+            int n = port.bulkTransfer(in, packet, packet.length, 200);
+            if (n <= 0) continue;
+            collected.write(packet, 0, n);
+            String reply = collected.toString("US-ASCII");
+            if (hasLine(reply, "OK") || hasLine(reply, "ERROR")) return reply;
+        }
+        throw new IOException(command + " reply timeout");
+    }
+}
diff --git a/src/xrt/targets/openxr_android/src/main/java/org/freedesktop/monado/openxr_runtime/Cv10UsbReader.java b/src/xrt/targets/openxr_android/src/main/java/org/freedesktop/monado/openxr_runtime/Cv10UsbReader.java
new file mode 100644
index 0000000..c7cb1d7
--- /dev/null
+++ b/src/xrt/targets/openxr_android/src/main/java/org/freedesktop/monado/openxr_runtime/Cv10UsbReader.java
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.freedesktop.monado.openxr_runtime;
+
+import org.freedesktop.monado.android_common.Cv10UsbAccess;
+import android.content.Context;
+import android.hardware.usb.*;
+import android.os.SystemClock;
+import android.util.Log;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.concurrent.TimeoutException;
+
+/** Synchronous, single-worker USB source. All methods are called by the same native thread. */
+public final class Cv10UsbReader {
+    private static final String TAG = "MonadoCV10";
+    private final Context context;
+    private final UsbManager manager;
+    private final Cv10PanelWake panel = new Cv10PanelWake();
+    private UsbDeviceConnection port;
+    private UsbInterface iface;
+    private UsbRequest request;
+    private ByteBuffer packet;
+    private boolean queued, enabled;
+    private int askedId = -1;
+    private long nextOpen, deadline, frames;
+
+    public Cv10UsbReader(Context ctx) {
+        context = ctx.getApplicationContext();
+        manager = context.getSystemService(UsbManager.class);
+    }
+
+    private int setSensor(int id) {
+        byte[] b = {(byte) id, 2, 0, 0, 0};
+        return port.controlTransfer(0x21, 9, 0x300|id, iface.getId(), b, b.length, 500);
+    }
+
+    private boolean open() {
+        UsbDevice glass = Cv10UsbAccess.find(manager);
+        if (glass==null) { askedId=-1; return false; }
+        if (!manager.hasPermission(glass)) {
+            if (askedId!=glass.getDeviceId()) {
+                askedId=glass.getDeviceId();
+                Cv10UsbAccess.request(context, manager, glass);
+                Log.i(TAG, "Requested CV10 USB permission");
+            }
+            return false;
+        }
+        panel.request(manager, glass);
+        for (int i=0; i<glass.getInterfaceCount(); i++) {
+            UsbInterface hid=glass.getInterface(i);
+            if (hid.getId()!=3 || hid.getAlternateSetting()!=0 || hid.getInterfaceClass()!=3 ||
+                hid.getInterfaceSubclass()!=0 || hid.getInterfaceProtocol()!=0) continue;
+            for (int j=0; j<hid.getEndpointCount(); j++) {
+                UsbEndpoint ep=hid.getEndpoint(j);
+                if (ep.getType()!=UsbConstants.USB_ENDPOINT_XFER_INT || ep.getAddress()!=0x84 ||
+                    ep.getMaxPacketSize()<60) continue;
+                port=manager.openDevice(glass);
+                if (port==null) return false;
+                if (!port.claimInterface(hid,false) && !port.claimInterface(hid,true)) { close(); return false; }
+                iface=hid;
+                request=new UsbRequest();
+                if (!request.initialize(port,ep)) { close(); return false; }
+                packet=ByteBuffer.allocateDirect(ep.getMaxPacketSize()).order(ByteOrder.LITTLE_ENDIAN);
+                enabled=setSensor(5)==5;
+                if (!enabled) { close(); return false; }
+                frames=0;
+                deadline=SystemClock.elapsedRealtime()+5000;
+                Log.i(TAG,"CV10 IMU enabled, interrupt IN 0x84");
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Device nanoseconds, zero for no sample, minus one for a disconnected stream. */
+    public long read(float[] imu) {
+        try {
+            if (!enabled) {
+                if (manager==null || SystemClock.elapsedRealtime()<nextOpen) {
+                    SystemClock.sleep(100);
+                    return 0;
+                }
+                nextOpen=SystemClock.elapsedRealtime()+500;
+                if (!open()) return 0;
+            }
+            if (!queued) {
+                packet.clear();
+                queued=request.queue(packet);
+                if (!queued) { close(); return -1; }
+            }
+            try {
+                if (port.requestWait(200)!=request) { close(); return -1; }
+            } catch (TimeoutException waiting) {
+                if (SystemClock.elapsedRealtime()>=deadline) { close(); return -1; }
+                return 0;
+            }
+            queued=false;
+            if (packet.position()!=60 || packet.get(0)!=1 || packet.getInt(12)!=0 || packet.getInt(28)!=1) {
+                if (SystemClock.elapsedRealtime()>=deadline) { close(); return -1; }
+                return 0;
+            }
+            long ns=((long)packet.getInt(4)<<32) | (packet.getInt(8)&0xffffffffL);
+            for (int i=0;i<3;i++) {
+                imu[i]=packet.getFloat(16+4*i)*9.8f;
+                imu[i+3]=(float)Math.toRadians(packet.getFloat(32+4*i));
+                if (!Float.isFinite(imu[i]) || !Float.isFinite(imu[i+3])) return 0;
+            }
+            deadline=SystemClock.elapsedRealtime()+2500;
+            if (frames++==0 || frames%5000==0) Log.i(TAG,"CV10 valid IMU samples="+frames+" deviceNs="+ns);
+            return ns;
+        } catch (RuntimeException failure) {
+            Log.w(TAG,"CV10 read failed",failure); close(); return -1;
+        }
+    }
+
+    public void close() {
+        try {
+            if (request!=null && queued) {
+                request.cancel();
+                try { port.requestWait(200); } catch (TimeoutException ignored) {}
+            }
+        } catch (RuntimeException ignored) {}
+        queued=false;
+        if (request!=null) { request.close(); request=null; }
+        if (port!=null) {
+            try { if (enabled) Log.i(TAG,"CV10 IMU disable bytes="+setSensor(6)); }
+            finally {
+                try { if (iface!=null) port.releaseInterface(iface); }
+                finally { port.close(); port=null; iface=null; enabled=false; }
+            }
+        }
+    }
+}
