+TEST_F(MessageQueueTest, requestFrameIfIdleLeavesExistingWakeIntact) {
+    const auto timing = scheduler::VSyncDispatch::ScheduleTiming{.workDuration = kDuration.ns(),
+                                                                 .readyDuration = 0,
+                                                                 .lastVsync = 0};
+    const scheduler::ScheduleResult scheduled{TimePoint::fromNs(1000), TimePoint::fromNs(2000)};
+    EXPECT_CALL(*mEventQueue.mHandler, isFramePending()).WillRepeatedly(Return(false));
+    EXPECT_CALL(*mVSyncDispatch, schedule(mCallbackToken, timing)).WillOnce(Return(scheduled));
+
+    const auto request = mEventQueue.requestFrameIfIdle(TimePoint::fromNs(0));
+    ASSERT_TRUE(request);
+    EXPECT_EQ(request->callbackTime, scheduled.callbackTime);
+    EXPECT_EQ(request->vsyncTime, scheduled.vsyncTime);
+    EXPECT_FALSE(mEventQueue.requestFrameIfIdle(TimePoint::fromNs(0)));
+
+    const auto queued = mEventQueue.getScheduledFrameResult();
+    ASSERT_TRUE(queued);
+    EXPECT_EQ(queued->callbackTime, scheduled.callbackTime);
+    EXPECT_EQ(queued->vsyncTime, scheduled.vsyncTime);
+}
