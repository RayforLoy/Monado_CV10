--- a/services/surfaceflinger/Scheduler/include/scheduler/FollowerSlot.h
+++ b/services/surfaceflinger/Scheduler/include/scheduler/FollowerSlot.h
@@ -19,6 +19,15 @@ constexpr int64_t kFollowerDeadlinePredictionSlackNs = 250'000;
 constexpr int64_t kFollowerPlanningLeadNs = kFollowerStartLeadNs + kFollowerDeadlinePredictionSlackNs;
 constexpr int64_t kFollowerMaxPhaseChangeNs = 1'000'000;

+// Reject a queued wake for a later display interval if the immediate interval was missed.
+constexpr bool isNextPacesetterVsync(int64_t previousVsyncNs, int64_t predictedVsyncNs,
+                                    int64_t scheduledVsyncNs, int64_t periodNs) {
+    if (periodNs <= 0 || scheduledVsyncNs <= previousVsyncNs) return false;
+    const int64_t tolerance = periodNs / 4;
+    const int64_t phaseDelta = scheduledVsyncNs - predictedVsyncNs;
+    return phaseDelta >= -tolerance && phaseDelta <= tolerance;
+}
