+std::optional<scheduler::ScheduleResult> MessageQueue::requestFrameIfIdle(TimePoint handledVsync) {
+    std::lock_guard lock(mVsync.mutex);
+    if (!mVsync.registration || mVsync.lastCallbackTime != handledVsync ||
+        mVsync.scheduledFrameTimeOpt || mHandler->isFramePending()) {
+        return std::nullopt;
+    }
+    mVsync.scheduledFrameTimeOpt =
+            mVsync.registration->schedule({.workDuration = mVsync.workDuration.get().count(),
+                                           .readyDuration = 0,
+                                           .lastVsync = handledVsync.ns()});
+    return mVsync.scheduledFrameTimeOpt;
+}
