diff --git a/services/surfaceflinger/CompositionEngine/include/compositionengine/FollowerPresentWindow.h b/services/surfaceflinger/CompositionEngine/include/compositionengine/FollowerPresentWindow.h
new file mode 100644
index 0000000..28f3d39
--- /dev/null
+++ b/services/surfaceflinger/CompositionEngine/include/compositionengine/FollowerPresentWindow.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+namespace android::compositionengine {
+
+// Values are recorded in trace. An open window alone does not establish that the
+// current pacesetter composition is complete or that an output can be abandoned.
+enum class FollowerPresentWindow {
+    kOpen,
+    kFenceUnavailable,
+    kRetireSettling,
+    kNoScheduledPacesetterWake,
+    kNextPacesetterWakeTooClose,
+    kFollowerPresentTooClose,
+};
+
+constexpr FollowerPresentWindow checkFollowerPresentWindow(
+        int64_t nowNs, std::optional<int64_t> retireNs, std::optional<int64_t> nextPacesetterWakeNs,
+        int64_t expectedFollowerPresentNs) {
+    // Fold7 research budgets. Replace with measurements of the intended execution path.
+    constexpr int64_t kRetireGuardNs = 500'000;
+    constexpr int64_t kPacesetterWakeGuardNs = 2'000'000;
+    constexpr int64_t kFollowerPresentLeadNs = 7'300'000;
+
+    if (!retireNs) return FollowerPresentWindow::kFenceUnavailable;
+    if (nowNs - *retireNs < kRetireGuardNs) return FollowerPresentWindow::kRetireSettling;
+    if (!nextPacesetterWakeNs) return FollowerPresentWindow::kNoScheduledPacesetterWake;
+    if (*nextPacesetterWakeNs - nowNs < kPacesetterWakeGuardNs) {
+        return FollowerPresentWindow::kNextPacesetterWakeTooClose;
+    }
+    if (expectedFollowerPresentNs - nowNs < kFollowerPresentLeadNs) {
+        return FollowerPresentWindow::kFollowerPresentTooClose;
+    }
+    return FollowerPresentWindow::kOpen;
+}
+
+} // namespace android::compositionengine
