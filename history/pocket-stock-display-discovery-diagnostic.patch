+                                DisplayManager.VIRTUAL_DISPLAY_FLAG_PRESENTATION,
+                        ))
+                        Log.i(TAG, "Stock discovery display id=${stockDiscoveryDisplay!!.display.displayId} name=$name")
+                        status.text = name
+                        controlsAvailable = true
+                        updateButtons()
+                    } catch (error: RuntimeException) {
+                        showError(error)
+                    }
+                }
+            },
+            onFirstFrame = { Log.i(TAG, "Stock discovery display sent first frame") },
