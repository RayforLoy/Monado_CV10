#version 460
#extension GL_GOOGLE_include_directive : require

#include "srgb.inc.glsl"
#include "cv10_enhanced.inc.glsl"


// The size of the distortion texture dimensions in texels.
layout(constant_id = 0) const int k_distortion_texel_count = 2;

// Should we do timewarp.
layout(constant_id = 1) const bool k_do_timewarp = false;

// Number of views (1 = mono, 2 = stereo). Sized at pipeline creation.
layout(constant_id = 2) const int k_view_count = 2;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D source[k_view_count];
layout(set = 0, binding = 1) uniform sampler2D distortion[3 * k_view_count];
layout(set = 0, binding = 2) uniform writeonly restrict image2D target;
layout(set = 0, binding = 3, std140) uniform restrict Config
{
	ivec4 views[2];
	vec4 pre_transform[2];
	vec4 post_transform[2];
	mat4 transform_timewarp_scanout_begin[2];
	mat4 transform_timewarp_scanout_end[2];
	vec4 distortion_options;
	vec4 inset_rect[2];
	vec4 context_to_inset[2];
}ubo;


vec2 position_to_uv(ivec2 extent, uint ix, uint iy)
{
	// Turn the index into floating point.
	vec2 xy = vec2(float(ix), float(iy));

	// The inverse of the extent of the target image is the pixel size in [0 .. 1] space.
	vec2 extent_pixel_size = vec2(1.0 / float(extent.x), 1.0 / float(extent.y));

	// Per-target pixel we move the size of the pixels.
	vec2 dist_uv = xy * extent_pixel_size;

	// Emulate a triangle sample position by offset half target pixel size.
	dist_uv = dist_uv + extent_pixel_size / 2.0;


	// To correctly sample we need to put position (0, 0) in the
	// middle of the (0, 0) texel in the distortion textures. That's why we
	// offset with half the texel size, pushing all samples into the middle
	// of each texels, a kin to a vertex buffer. We need to put uv coord
	// (1, 1) in the middle of the last texel, that pixel is (size - 1)
	// texels away from the first texel. So we need to scale [0 .. 1] to
	// [0 .. size - 1].

#define DIM (float(k_distortion_texel_count))
#define STRETCH ((DIM - 1.0) / DIM)
#define OFFSET (1.0 / (DIM * 2.0))

	dist_uv = (dist_uv * STRETCH) + OFFSET;

	return dist_uv;
}

vec2 transform_uv_subimage(vec2 uv, uint iz)
{
	vec2 values = uv;

	// To deal with OpenGL flip and sub image view.
	values.xy = values.xy * ubo.post_transform[iz].zw + ubo.post_transform[iz].xy;

	// Ready to be used.
	return values.xy;
}

vec2 transform_uv_timewarp(vec2 uv, uint iz)
{
	vec4 values = vec4(uv, -1, 1);

	// From uv to tan angle (tangent space).
	values.xy = values.xy * ubo.pre_transform[iz].zw + ubo.pre_transform[iz].xy;
	values.y = -values.y; // Flip to OpenXR coordinate system.

	// Timewarp including scanline timewarp for rolling refresh panels.
	values = ubo.transform_timewarp_scanout_begin[iz] * values * (1 - uv.y) +
	         ubo.transform_timewarp_scanout_end[iz] * values * uv.y;
	values.xy = values.xy * (1.0 / max(values.w, 0.00001));

	// From [-1, 1] to [0, 1]
	values.xy = values.xy * 0.5 + 0.5;

	// Done.
	return values.xy;
}

vec2 transform_uv(vec2 uv, uint iz)
{
	if (k_do_timewarp) {
		uv = transform_uv_timewarp(uv, iz);
	}

	return transform_uv_subimage(uv, iz);
}

bool inside_view(vec2 uv)
{
	return all(greaterThanEqual(uv, vec2(0))) && all(lessThan(uv, vec2(1)));
}

vec3 sample_atlas(sampler2D atlas, vec2 uv, vec4 rect, vec2 half_texel)
{
	vec2 first = rect.xy + half_texel;
	vec2 last = rect.xy + rect.zw - half_texel;
	return texture(atlas, clamp(uv * rect.zw + rect.xy, first, last)).rgb;
}

vec3 sample_foveated(sampler2D atlas, vec2 uv, uint iz, vec2 half_texel)
{
	vec4 transform = ubo.context_to_inset[iz];
	vec2 inset_uv = fma(uv, transform.zw, transform.xy);
	float weight = 0.0;
	vec3 inset = vec3(0);
	if (inside_view(inset_uv)) {
		vec2 distance = min(inset_uv, 1.0 - inset_uv);
		weight = smoothstep(0.0, ubo.distortion_options.y, min(distance.x, distance.y));
		inset = sample_atlas(atlas, inset_uv, ubo.inset_rect[iz], half_texel);
		if (weight >= 1.0) {
			return inset;
		}
	}

	vec3 context = inside_view(uv) ? sample_atlas(atlas, uv, ubo.post_transform[iz], half_texel) : vec3(0);
	return mix(context, inset, weight);
}

vec3 sample_foveated_rgb(sampler2D atlas, vec2 r_uv, vec2 g_uv, vec2 b_uv, uint iz, vec2 half_texel)
{
	return vec3(sample_foveated(atlas, r_uv, iz, half_texel).r,
	            sample_foveated(atlas, g_uv, iz, half_texel).g,
	            sample_foveated(atlas, b_uv, iz, half_texel).b);
}

bool all_enhancement_taps_in_inset(vec2 r_uv, vec2 g_uv, vec2 b_uv, vec4 transform)
{
	if (!inside_view(r_uv) || !inside_view(g_uv) || !inside_view(b_uv)) {
		return false;
	}

	// The extrema enclose all four offsets of all three chromatic samples.
	vec2 margin = vec2(CV10_ENHANCED_SAMPLE_STEP);
	vec2 first = fma(min(min(r_uv, g_uv), b_uv) - margin, transform.zw, transform.xy);
	vec2 last = fma(max(max(r_uv, g_uv), b_uv) + margin, transform.zw, transform.xy);
	vec2 distance = min(min(first, last), 1.0 - max(first, last));
	return all(greaterThanEqual(distance, vec2(ubo.distortion_options.y)));
}

vec3 sample_inset_rgb(sampler2D atlas, vec2 r_uv, vec2 g_uv, vec2 b_uv, uint iz, vec2 half_texel)
{
	vec4 transform = ubo.context_to_inset[iz];
	vec4 rect = ubo.inset_rect[iz];
	return vec3(sample_atlas(atlas, fma(r_uv, transform.zw, transform.xy), rect, half_texel).r,
	            sample_atlas(atlas, fma(g_uv, transform.zw, transform.xy), rect, half_texel).g,
	            sample_atlas(atlas, fma(b_uv, transform.zw, transform.xy), rect, half_texel).b);
}

vec3 sample_enhancement_neighbours(sampler2D atlas, vec2 r_uv, vec2 g_uv, vec2 b_uv, uint iz, vec2 half_texel)
{
	const vec2 dx = vec2(CV10_ENHANCED_SAMPLE_STEP, 0.0);
	const vec2 dy = vec2(0.0, CV10_ENHANCED_SAMPLE_STEP);
	if (all_enhancement_taps_in_inset(r_uv, g_uv, b_uv, ubo.context_to_inset[iz])) {
		return sample_inset_rgb(atlas, r_uv - dx, g_uv - dx, b_uv - dx, iz, half_texel)
		       + sample_inset_rgb(atlas, r_uv + dx, g_uv + dx, b_uv + dx, iz, half_texel)
		       + sample_inset_rgb(atlas, r_uv - dy, g_uv - dy, b_uv - dy, iz, half_texel)
		       + sample_inset_rgb(atlas, r_uv + dy, g_uv + dy, b_uv + dy, iz, half_texel);
	}

	// Near the inset edge, each tap still needs its own context blend.
	return sample_foveated_rgb(atlas, r_uv - dx, g_uv - dx, b_uv - dx, iz, half_texel)
	       + sample_foveated_rgb(atlas, r_uv + dx, g_uv + dx, b_uv + dx, iz, half_texel)
	       + sample_foveated_rgb(atlas, r_uv - dy, g_uv - dy, b_uv - dy, iz, half_texel)
	       + sample_foveated_rgb(atlas, r_uv + dy, g_uv + dy, b_uv + dy, iz, half_texel);
}

void main()
{
	uint ix = gl_GlobalInvocationID.x;
	uint iy = gl_GlobalInvocationID.y;
	uint iz = gl_GlobalInvocationID.z;

	ivec2 offset = ivec2(ubo.views[iz].xy);
	ivec2 extent = ivec2(ubo.views[iz].zw);

	if (ix >= extent.x || iy >= extent.y) {
		return;
	}

	vec2 dist_uv = position_to_uv(extent, ix, iy);

	vec2 r_uv = texture(distortion[k_view_count * 0 + iz], dist_uv).xy;
	vec2 g_uv = texture(distortion[k_view_count * 1 + iz], dist_uv).xy;
	vec2 b_uv = texture(distortion[k_view_count * 2 + iz], dist_uv).xy;

	// Sample the source with distorted and chromatic-aberration corrected samples.
	vec3 colour;
	if (ubo.distortion_options.y > 0.0) {
		vec2 half_texel = 0.5 / vec2(textureSize(source[iz], 0));
		float radius = length(g_uv - vec2(0.5));
		r_uv = transform_uv_timewarp(r_uv, iz);
		g_uv = transform_uv_timewarp(g_uv, iz);
		b_uv = transform_uv_timewarp(b_uv, iz);
		colour = sample_foveated_rgb(source[iz], r_uv, g_uv, b_uv, iz, half_texel);
		if (ubo.distortion_options.x > 0.0 && radius < CV10_ENHANCED_RADIUS) {
			vec3 neighbours = sample_enhancement_neighbours(source[iz], r_uv, g_uv, b_uv, iz, half_texel);
			colour = cv10_enhance_colour(colour, neighbours, radius);
		}
	} else {
		r_uv = transform_uv(r_uv, iz);
		g_uv = transform_uv(g_uv, iz);
		b_uv = transform_uv(b_uv, iz);
		colour = vec3(texture(source[iz], r_uv).r, texture(source[iz], g_uv).g, texture(source[iz], b_uv).b);
		if (ubo.distortion_options.x > 0.0) {
			colour = cv10_enhance(source[iz], colour, r_uv, g_uv, b_uv, ubo.post_transform[iz]);
		}
	}

	// Do colour correction here since there are no automatic conversion in hardware available.
	imageStore(target, ivec2(offset.x + ix, offset.y + iy), vec4(from_linear_to_srgb(colour), 1));
}
